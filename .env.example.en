# English demo profile - DGX Spark Unsloth Qwen3.6 (LAN / Tailscale).
# Copy to .env:
#   Windows:  copy .env.example.en .env
#   macOS/Linux: cp .env.example.en .env
# Also copy into course_implementation/ and deep_research_agent/ if you run
# those packages from their own directories.
# NOTE: .env is gitignored.

# =============================================================================
# DEFAULT: DGX Spark vLLM (OpenAI-compatible)
# =============================================================================
# Verified on Spark host network: unsloth/Qwen3.6-35B-A3B-NVFP4 @ :8888
# Prefer LAN when on the same Wi-Fi; use Tailscale when off-LAN.
LLM_PROVIDER=openai
LLM_MODEL=unsloth/Qwen3.6-35B-A3B-NVFP4
LLM_BASE_URL=http://192.168.1.164:8888/v1
LLM_API_KEY=EMPTY

# Tailscale fallback (same model, remote access):
# LLM_BASE_URL=http://100.88.156.38:8888/v1

# SSH tunnel fallback (ssh spark with LocalForward 18000 -> 127.0.0.1:8888):
# LLM_BASE_URL=http://127.0.0.1:18000/v1

# =============================================================================
# Optional cloud providers (commented - not used for the English Spark demo)
# =============================================================================
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-5
# ANTHROPIC_API_KEY=sk-ant-api03-YOUR_KEY_HERE

# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-proj-YOUR_KEY_HERE

# LLM_PROVIDER=google
# LLM_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=AIzaSy-YOUR_KEY_HERE

# LLM_PROVIDER=openrouter
