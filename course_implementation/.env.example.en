# English demo — DGX Spark Unsloth Qwen3.6 (LAN). Copy to .env in this folder.
# Windows: copy .env.example.en .env
# macOS/Linux: cp .env.example.en .env

LLM_PROVIDER=openai
LLM_MODEL=unsloth/Qwen3.6-35B-A3B-NVFP4
LLM_BASE_URL=http://192.168.1.164:8888/v1
LLM_API_KEY=EMPTY

# Tailscale: LLM_BASE_URL=http://100.88.156.38:8888/v1
# SSH tunnel (ssh spark → LocalForward 18000): LLM_BASE_URL=http://127.0.0.1:18000/v1

# Cloud alternatives (optional):
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-5
# ANTHROPIC_API_KEY=
