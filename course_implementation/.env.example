# Copy to .env in this directory or the repo root. .env is gitignored.

# Default: local vLLM via aisuite's openai provider
LLM_PROVIDER=openai
LLM_MODEL=nvidia/Qwen3.6-35B-A3B-NVFP4
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=EMPTY

# Claude (aisuite anthropic provider). Put the real key only in .env.
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-5
# ANTHROPIC_API_KEY=

# OpenAI cloud instead of local vLLM
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o
# LLM_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=

# Google Gemini via Google's OpenAI-compatible endpoint (NOT Vertex AI).
# aisuite[google] is Vertex and is not used. Needs only GEMINI_API_KEY
# (GOOGLE_API_KEY is accepted as an alias). The client sets this base URL
# when LLM_PROVIDER is google or gemini; you may also set it explicitly.
# LLM_PROVIDER=google
# LLM_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=
# # GOOGLE_API_KEY=
# # LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Ollama
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.3
# LLM_BASE_URL=http://127.0.0.1:11434
