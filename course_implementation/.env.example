# Choose a language profile, then copy to .env in this folder.
# English (DGX Spark):  copy .env.example.en .env   |  cp .env.example.en .env
# 中文 (LM Studio):     copy .env.example.zh .env   |  cp .env.example.zh .env
# Plain copy of this file defaults to LM Studio (Chinese / offline profile).

LLM_PROVIDER=openai
LLM_MODEL=qwen3.8-4b-distill
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_API_KEY=EMPTY

# English / DGX Spark — prefer .env.example.en
# LLM_MODEL=unsloth/Qwen3.6-35B-A3B-NVFP4
# LLM_BASE_URL=http://192.168.1.164:8888/v1

# Claude (aisuite anthropic provider). Put the real key only in .env.
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-5
# ANTHROPIC_API_KEY=

# OpenAI cloud
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o
# LLM_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=

# Google Gemini (OpenAI-compatible, not Vertex)
# LLM_PROVIDER=google
# LLM_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=

# OpenRouter
# LLM_PROVIDER=openrouter
# LLM_MODEL=openai/gpt-4o-mini
# OPENROUTER_API_KEY=

# Ollama
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.3
# LLM_BASE_URL=http://127.0.0.1:11434
