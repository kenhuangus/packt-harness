# LLM Configuration Example for Harness Engineering Course
# Copy this file to .env and configure your desired model provider

LLM_PROVIDER=openai
LLM_MODEL=openai:qwen2.5-coder
LLM_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_API_KEY=EMPTY

# Cloud Provider Examples:
# ANTHROPIC_API_KEY=sk-ant-xxx
# OPENAI_API_KEY=sk-proj-xxx
