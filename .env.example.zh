# 中文演示配置 — 本机 LM Studio Qwen（OpenAI 兼容 API）。
# 复制为 .env：
#   Windows:  copy .env.example.zh .env
#   macOS/Linux: cp .env.example.zh .env
# 若在 course_implementation/ 或 deep_research_agent/ 目录单独运行，
# 请同样复制一份到对应目录。
# 注意：.env 已被 gitignore，请勿提交密钥。

# =============================================================================
# 默认：本机 LM Studio（无需 API Key）
# =============================================================================
# 在 LM Studio 中加载 Qwen，并启用本地服务器（默认端口 1234）。
LLM_PROVIDER=openai
LLM_MODEL=qwen3.8-4b-distill
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_API_KEY=EMPTY

# =============================================================================
# 可选：云端或其他本地引擎（默认注释）
# =============================================================================
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-5
# ANTHROPIC_API_KEY=sk-ant-api03-YOUR_KEY_HERE

# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-proj-YOUR_KEY_HERE

# LLM_PROVIDER=google
# LLM_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=AIzaSy-YOUR_KEY_HERE

# LLM_PROVIDER=openrouter
# LLM_MODEL=openai/gpt-4o-mini
# OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE

# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5-coder
# LLM_BASE_URL=http://127.0.0.1:11434
