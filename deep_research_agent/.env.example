# Copy to .env in this directory or repository root:
# Linux/macOS: cp .env.example .env
# Windows: copy .env.example .env
# NOTE: .env is gitignored to protect your API keys.

# =============================================================================
# 1. DEFAULT: Local OpenAI-Compatible vLLM / Ollama (No API Key Required)
# =============================================================================
LLM_PROVIDER=openai
LLM_MODEL=nvidia/Qwen3.6-35B-A3B-NVFP4
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=EMPTY

# =============================================================================
# 2. ANTHROPIC CLAUDE (aisuite anthropic provider)
# =============================================================================
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-5
# ANTHROPIC_API_KEY=

# =============================================================================
# 3. OPENAI (aisuite openai provider)
# =============================================================================
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=

# =============================================================================
# 4. GOOGLE GEMINI (OpenAI-compatible endpoint, NOT Vertex AI)
# =============================================================================
# aisuite[google] is Vertex AI and is not used. Gemini needs only
# GEMINI_API_KEY (GOOGLE_API_KEY is accepted as an alias).
# LLM_PROVIDER=google
# LLM_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=
# # GOOGLE_API_KEY=
# # LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# =============================================================================
# 5. OLLAMA LOCAL ENDPOINT
# =============================================================================
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5-coder
# LLM_BASE_URL=http://127.0.0.1:11434
