# Choose a language profile, then copy to .env in this folder.
# English (DGX Spark):  copy .env.example.en .env   |  cp .env.example.en .env
# 中文 (LM Studio):     copy .env.example.zh .env   |  cp .env.example.zh .env
# Plain copy of this file defaults to LM Studio (Chinese / offline profile).

LLM_PROVIDER=openai
LLM_MODEL=qwen3.8-4b-distill
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_API_KEY=EMPTY

