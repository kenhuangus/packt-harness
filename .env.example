# Packt Harness — choose a language profile, then copy to .env
#
# English (DGX Spark Qwen3.6 on LAN):
#   Windows:      copy .env.example.en .env
#   macOS/Linux:  cp .env.example.en .env
#
# 中文 (本机 LM Studio Qwen):
#   Windows:      copy .env.example.zh .env
#   macOS/Linux:  cp .env.example.zh .env
#
# Also place the same .env under course_implementation/ and
# deep_research_agent/ if you run those packages from their folders.
# NOTE: .env is gitignored — never commit API keys.
#
# Profile files:
#   .env.example.en  → DGX Spark vLLM  http://192.168.1.164:8888/v1
#   .env.example.zh  → LM Studio       http://127.0.0.1:1234/v1
#
# Default below matches the Chinese / LM Studio profile so a plain
# `copy .env.example .env` still works offline without Spark.

LLM_PROVIDER=openai
LLM_MODEL=qwen3.8-4b-distill
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_API_KEY=EMPTY

# --- English / DGX Spark (prefer .env.example.en) ---
# LLM_PROVIDER=openai
# LLM_MODEL=unsloth/Qwen3.6-35B-A3B-NVFP4
# LLM_BASE_URL=http://192.168.1.164:8888/v1
# LLM_API_KEY=EMPTY
# # Tailscale: http://100.88.156.38:8888/v1
# # SSH tunnel (ssh spark): http://127.0.0.1:18000/v1

